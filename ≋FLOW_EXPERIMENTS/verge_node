"""
        try:
            with open(target_file, "a", encoding="utf-8") as f:
                f.write(md_block)
            print(f"[{self.name}] Appended finding to {target_file}")
            return target_file
        except Exception as e:
            print(f"[{self.name}] Append error: {e}")
            return "error"

    def self_audit(self) -> Dict[str, Any]:
        issues = []
        if not self.findings_log:
            issues.append("No findings produced yet in this session.")
        for f in self.findings_log:
            if not f.falsifiers or not f.next_probes:
                issues.append(f"Finding {f.id} is missing falsifiers or next_probes.")
        return {
            "node": self.name,
            "findings_count": len(self.findings_log),
            "issues_found": issues,
            "session_constraints": self.session_constraints,
            "recommendation": "Run more pure_python_probes and tighten falsifier language.",
        }

    def health_check(self) -> str:
        return f"{self.name} v{self.version} | findings logged: {len(self.findings_log)} | lycheetah: {self._lycheetah_available} | status: experimental-verge (our files only)"

