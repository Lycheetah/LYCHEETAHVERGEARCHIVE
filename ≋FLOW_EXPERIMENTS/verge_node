    def propose_finding(self, material: str, lens: str, extra_falsifiers: Optional[List[str]] = None, extra_probes: Optional[List[str]] = None, run_probes: bool = True) -> FindingReport:
        timestamp = datetime.now(timezone.utc).isoformat()
        fid = f"verge-{lens}-{int(time.time())}"
        observation = f"Material under lens '{lens}' synthesized by {self.name}."
        probe_results = {}
        if run_probes:
            if "master" in lens.lower():
                probe_results["master"] = self.run_pure_python_probe("master_eq_step")
            if "hexie" in lens.lower() or "tianxia" in lens.lower():
                probe_results["hexie"] = self.run_pure_python_probe("aura_hexie_stub")
        unique_take = self._forge_unique_take(lens, material, probe_results)
        report = FindingReport(
            id=fid,
            timestamp=timestamp,
            lens=lens,
            core_observation=observation,
            unique_take=unique_take,
            status="[CONJECTURE]",
            falsifiers=extra_falsifiers or [f"Run trajectories showing no difference in coherence or drift."],
            next_probes=extra_probes or ["Use the node's pure probes + Codex data (via read tools) for validation."],
            canonical_references=["30_MAPS/COMPOSITION_MAP.md (read-only)", "11_MATHEMATICAL_FOUNDATIONS/MASTER_EQUATION_CALIBRATION.md (read-only)"],
            metadata={"node_version": self.version, "internal_probes": list(probe_results.keys())},
        )
        if not self._passes_experimental_honesty_field(report):
            raise ValueError(f"{self.name}: Output failed Experimental Honesty Field.")
        self.findings_log.append(report)
        print(f"[{self.name}] Finding forged: {fid} (lens={lens})")
        return report

    def _passes_experimental_honesty_field(self, report: FindingReport) -> bool:
        if not report.falsifiers or any("REQUIRED" in f for f in report.falsifiers):
            return False
        if not report.next_probes or any("REQUIRED" in p for p in report.next_probes):
            return False
        if report.status != "[CONJECTURE]":
            return False
        return True

    def run_synthesis_pass(self, material: str, lens: str, auto_log: bool = True, target_log: str = "verge_findings_log.md") -> FindingReport:
        report = self.propose_finding(material, lens, run_probes=True)
        if auto_log:
            self.log_to_research_file(report, target_log)
        return report

    def log_to_research_file(self, report: FindingReport, target_file: str = "verge_findings_log.md") -> str:
        md_block = f"""

