            S = float(kwargs.get("S", 0.4))
            if S <= 0: S = 1e-9
            pi = (E * P) / S
            return {"probe": "pi_calc", "E": E, "P": P, "S": S, "Pi": pi, "note": "Pure Python. Identical to CASCADE definition."}

        elif probe_type == "master_eq_step":
